{:tasks
 {:requires ([babashka.process :as p]
             [clojure.string :as str])

  :init
  (do
    ;; One entry per standalone example, and the only place they are listed.
    ;; Every task below walks this vector, including `demos:examples`, which
    ;; feeds screen-grab. Adding a runtime means adding a directory and an
    ;; entry here; nothing else in this file changes.
    ;;
    ;; :target is for screen-grab, and is nil wherever the spawned pid already
    ;; owns the window. scripts/run-example.sh execs the :cmd, so bb, the
    ;; clojure script (which execs java) and jolt all keep their pid. jank
    ;; cannot: lein starts the compiled binary as a child, so that one names
    ;; its app instead. Measured with `cgevent windows`, not assumed.
    ;;
    ;; Naming an app only works when the name is unambiguous, and none of
    ;; these are: `bb` matches 10 processes on this machine, `java` 23, and
    ;; lein-jank runs two of its own named `jank`. So every item here is
    ;; targeted by the pid screen-grab spawned, which is what the `exec` in
    ;; run-example.sh preserves.
    (def examples
      [{:id "babashka" :dir "babashka-example" :task "babashka"
        :runtime "babashka" :binding "babashka.ffi"
        :cmd "bb pacman"
        :desc "raylib over babashka.ffi. Colours packed into a uint and Pac-Man emitted as an rlgl triangle fan, because this FFI moves scalars rather than structs."}
       {:id "clojure" :dir "clojure-example" :task "clj"
        :runtime "Clojure/JVM" :binding "raylib-clj (coffi / Panama)"
        :cmd "clojure -M:pacman"
        :desc "raylib over raylib-clj, which binds it with coffi on Panama. Structs arrive as plain maps, so DrawCircleSector is called directly."}
       {:id "jank" :dir "jank-example" :task "jank"
        :runtime "jank" :binding "cpp/ interop (raylib-sys)"
        ;; The AOT binary, not `lein run`. Two reasons, both measured: lein
        ;; starts TWO processes named `jank`, so naming the app is ambiguous
        ;; and cgevent refuses it, while the binary's own pid owns its window.
        ;; And `lein run` costs about 13s of startup and JIT before the first
        ;; frame, where the binary is drawing in about a second.
        ;; `bb record` preflights the binary and tells you how to build it.
        :cmd "./target/debug/jank-example" :target nil
        :desc "raylib over jank's cpp/ interop, including raylib.h directly. Recorded from the AOT binary, which starts in about a second; `lein run` compiles as it loads and takes roughly 13 seconds longer to reach the first frame."}
       {:id "jolt" :dir "jolt-example" :task "jolt"
        :runtime "jolt" :binding "net.b12n/raylib (jolt.ffi)"
        :cmd "jolt -M:pacman"
        :desc "raylib over net.b12n/raylib on jolt.ffi. The wrapper's sector! measures from 0=up, where raylib measures from 0=right."}])

    (defn docs-engine
      "Where the docs-engine checkout lives. It is a separate repo, not a
       dependency, so this is a path rather than a coordinate."
      []
      (let [d (or (System/getenv "DOCS_ENGINE")
                  (str (System/getProperty "user.home") "/dev/jlt-commons/docs-engine"))]
        (when-not (.isDirectory (java.io.File. d))
          (println "docs-engine not found at" d)
          (println "clone https://github.com/jlt-commons/docs-engine, or set DOCS_ENGINE")
          (System/exit 2))
        d))

    (defn find-example
      [nm]
      (first (filter (fn [e] (= nm (:id e))) examples)))

    (defn dir-of
      "The directory for a short name, or a listing and a non-zero exit."
      [nm]
      (if-let [e (find-example nm)]
        (:dir e)
        (do (println "unknown example:" (pr-str nm))
            (println "try one of:" (str/join ", " (map :id examples)))
            (System/exit 2))))

    (defn run-in!
      "Delegate to the standalone project's OWN bb.edn. Each example stays
       runnable on its own; this is a convenience, not a second build system."
      [nm task args]
      (let [dir (dir-of nm)]
        (println (str "==> " dir " : bb " task
                      (when (seq args) (str " " (str/join " " args)))))
        (apply p/shell {:dir dir} "bb" task args)))

    (defn in-each!
      "Run a task in every example, reporting each result rather than aborting
       the sweep on the first failure."
      [task args]
      (let [results (mapv (fn [e]
                            (let [dir (:dir e)
                                  _ (println (str "\n==> " dir " : bb " task))
                                  {:keys [exit]} (apply p/shell {:dir dir :continue true}
                                                        "bb" task args)]
                              [dir exit]))
                          examples)]
        (println "\n  summary")
        (doseq [r results]
          (println (format "  %-18s %s" (first r)
                           (if (zero? (second r)) "ok" (str "FAILED exit " (second r))))))
        (when (some (fn [r] (not (zero? (second r)))) results)
          (System/exit 1)))))

  info {:doc "What lives here and how to run it"
        :task (do (println)
                  (println "  raylib-pacman")
                  (println "  One Pac-Man, four runtimes, each a standalone project.")
                  (println)
                  (doseq [e examples]
                    (println (format "  bb %-10s %-18s %-12s %s"
                                     (:task e) (:dir e) (:runtime e) (:binding e))))
                  (println)
                  (println "  run one")
                  (println "    bb jank                  play it")
                  (println "    bb jank 10               quit after 10 game-seconds")
                  (println "    bb play jank 3 out.png 76  quit after 3, capture frame 76")
                  (println)
                  (println "  run all")
                  (println "    bb run-all [secs]        cycle every example, a demo reel")
                  (println "    bb check-all             compile or load every example")
                  (println "    bb shot-all              capture a PNG from each")
                  (println "    bb doctor-all            check every toolchain")
                  (println "    bb shots                 refresh docs/demos/*.png stills")
                  (println "    bb record                refresh docs/demos/*.gif")
                  (println)
                  (println "  docs site")
                  (println "    bb docs:build            build _site/")
                  (println "    bb docs:serve            build and serve on :3000")
                  (println "    bb docs:clean            delete the build output")
                  (println)
                  (println "  Each directory also stands alone:")
                  (println "    cd jank-example && bb info")
                  (println))}

  ;; --- run one -------------------------------------------------------------

  ;; Named `play` rather than `run`, and `clj` rather than `clojure`, because
  ;; both of those are bb built-ins and shadowing one warns on every call.
  play {:doc "Run one example by name: bb play <name> [secs] [shot] [frame]"
        :task (let [args *command-line-args*]
                (if (empty? args)
                  (do (println "usage: bb play <name> [secs] [shot.png] [frame]")
                      (println "names:" (str/join ", " (map :id examples)))
                      (System/exit 2))
                  (run-in! (first args) "pacman" (rest args))))}

  babashka {:doc "Run the babashka example"
            :task (run-in! "babashka" "pacman" *command-line-args*)}

  clj {:doc "Run the Clojure example"
       :task (run-in! "clojure" "pacman" *command-line-args*)}

  jank {:doc "Run the jank example"
        :task (run-in! "jank" "pacman" *command-line-args*)}

  jolt {:doc "Run the jolt example"
        :task (run-in! "jolt" "pacman" *command-line-args*)}

  ;; --- run all -------------------------------------------------------------

  run-all {:doc "Cycle every example for N seconds each (default 10)"
           :task (let [secs (or (first *command-line-args*) "10")]
                   (in-each! "pacman" [secs]))}

  check-all {:doc "Compile or load every example"
             :task (in-each! "check" [])}

  shot-all {:doc "Run each example for 3 seconds and capture a PNG"
            :task (in-each! "shot" [])}

  doctor-all {:doc "Check every toolchain"
              :task (in-each! "doctor" [])}

  shots {:doc "Refresh docs/demos/*-example.png (stills) from a live run of each"
         :task (do (p/shell "mkdir" "-p" "docs/demos")
                   (doseq [e examples]
                     (let [dir (:dir e)
                           png (str dir ".png")]
                       (println (str "\n==> " dir))
                       (apply p/shell {:dir dir :continue true}
                              "bb" ["pacman" "4" png "140"])
                       (p/shell {:continue true}
                                "sh" "-c" (str "mv -f " dir "/" png " docs/demos/" png))))
                   (p/shell "sh" "-c" "ls -la docs/demos/"))}

  ;; --- animated demos, via screen-grab -------------------------------------

  demos:examples
  {:doc "Print the demo item list as EDN for screen-grab"
   :task
   (prn (mapv (fn [e]
                {:id (:dir e)
                 :group "ports"
                 :desc (:desc e)
                 ;; screen-grab TOKENIZES :run rather than handing it to a
                 ;; shell, so `cd X && ...` here would exec `cd`. The wrapper
                 ;; script is the shell that string cannot be. Its deadline
                 ;; outlasts the capture, so the window is still there for the
                 ;; whole take and the app still exits on its own afterwards.
                 :run (str "scripts/run-example.sh " (:dir e) " 30 " (:cmd e))
                 :src (str (:dir e) "/src/raylib_pacman/pacman."
                           (if (= "jank" (:id e)) "jank" "clj"))
                 :target (:target e)})
              examples))}

  ;; --- documentation site, via docs-engine ---------------------------------
  ;;
  ;; The engine lives in its own checkout and is pointed at this project, so
  ;; these tasks shell into it rather than vendoring anything. Override the
  ;; location with DOCS_ENGINE if yours is elsewhere.
  ;;
  ;; None of these publish. See docs/site.edn for why, and for what wiring the
  ;; publish half would mean.

  docs:build {:doc "Build the docs site into _site/ (needs the docs-engine checkout)"
              :task (p/shell {:dir (docs-engine)} "jolt" "run" "build" (System/getProperty "user.dir"))}

  docs:serve {:doc "Build the docs site and serve it at localhost:3000"
              :task (apply p/shell {:dir (docs-engine)} "bb" "serve"
                           (System/getProperty "user.dir") *command-line-args*)}

  docs:clean {:doc "Delete the docs site build output"
              :task (p/shell {:dir (docs-engine)} "jolt" "run" "clean" (System/getProperty "user.dir"))}

  ;; screen-grab and cgevent are INTERNAL tools and are not public yet, so this
  ;; task only works on a machine that has them. The GIFs it produces are
  ;; committed, which is what keeps the docs buildable without them.
  record {:doc "Re-record docs/demos/*.gif (maintainer-only; needs the internal screen-grab)"
          :task (apply p/shell "screen-grab" "record"
                       "--manifest" "scripts/demo_manifest.edn"
                       *command-line-args*)}}}
