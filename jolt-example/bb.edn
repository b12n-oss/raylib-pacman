{:tasks
 {:requires ([babashka.process :as p])

  info {:doc "Every task in this example, grouped"
        :task (do (println)
                  (println "  raylib-pacman / jolt-example")
                  (println "  raylib called from jolt over jolt.ffi")
                  (println)
                  (println "  bb pacman           run it, window stays open")
                  (println "  bb pacman 10        run it, quit after 10 seconds")
                  (println "  bb shot             run 3s, write pacman.png")
                  (println "  bb check            compile the namespace, no window")
                  (println "  bb doctor           check jolt and libraylib")
                  (println))}

  pacman {:doc "Pac-Man with the classic ghost personalities"
          :task (apply p/shell "jolt" "-M:pacman" *command-line-args*)}

  shot {:doc "Run for 3 seconds and write pacman.png on frame 60"
        :task (p/shell "jolt" "-M:pacman" "3" "pacman.png")}

  check {:doc "Compile the namespace without opening a window"
         :task (do (p/shell "jolt" "-e" "(require (quote raylib-pacman.pacman))")
                   (println "OK  raylib-pacman.pacman compiled"))}

  doctor {:doc "Check jolt and libraylib"
          :task (do (p/shell {:continue true} "sh" "-c"
                             "printf 'jolt       '; jolt --version 2>/dev/null || echo 'NOT FOUND'")
                    (p/shell {:continue true} "sh" "-c"
                             "printf 'libraylib  '; ls /opt/homebrew/lib/libraylib.dylib 2>/dev/null || ldconfig -p 2>/dev/null | grep -m1 libraylib || echo 'NOT FOUND - brew install raylib'"))}}}
